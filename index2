}

// ══════════════════════════════════════════
//  MOOD
// ══════════════════════════════════════════
function getMoodData(score) {
  if (score >= 80) return { icon: '😊', label: 'Доволен', color: '#3D7A5C' };
  if (score >= 60) return { icon: '🙂', label: 'Нейтральное', color: '#6B6560' };
  if (score >= 40) return { icon: '😕', label: 'Недоволен', color: '#B57A2B' };
  return { icon: '😠', label: 'Раздражён', color: '#B5412B' };
}

function updateMoodUI() {
  const clamped = Math.max(0, Math.min(100, mood));
  const data = getMoodData(clamped);
  document.getElementById('mood-icon').textContent = data.icon;
  document.getElementById('mood-text').textContent = data.label;
  document.getElementById('mood-score').textContent = clamped;
  const bar = document.getElementById('mood-bar');
  bar.style.width = clamped + '%';
  bar.style.backgroundColor = data.color;
}

// ══════════════════════════════════════════
//  NAVIGATION
// ══════════════════════════════════════════
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0, 0);
}
function showIntro() { showScreen('intro'); }
function showSelector() { showScreen('selector'); }

function startScenario(idx) {
  currentScenario = scenarios[idx];
  currentStep = 0;
  mood = 60;
  correctCount = 0;
  wrongCount = 0;
  document.getElementById('game-title-sm').textContent = currentScenario.title;
  document.getElementById('char-avatar').innerHTML = getAvatar(currentScenario.clientType);
  document.getElementById('bubble-name').textContent = currentScenario.clientName;
  buildStepIndicator();
  showScreen('game');
  renderStep();
}

function buildStepIndicator() {
  const el = document.getElementById('step-indicator');
  el.innerHTML = '';
  currentScenario.steps.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'step-dot' + (i === 0 ? ' active' : '');
    d.id = 'dot-' + i;
    el.appendChild(d);
  });
}

function updateStepIndicator() {
  currentScenario.steps.forEach((_, i) => {
    const d = document.getElementById('dot-' + i);
    if (!d) return;
    d.className = 'step-dot' + (i < currentStep ? ' done' : i === currentStep ? ' active' : '');
  });
  document.getElementById('progress-label').textContent = `${currentStep + 1} / ${currentScenario.steps.length}`;
}

// ══════════════════════════════════════════
//  RENDER STEP
// ══════════════════════════════════════════
function renderStep() {
  answered = false;
  updateStepIndicator();
  updateMoodUI();

  const step = currentScenario.steps[currentStep];

  // mood delta from emotion
  if (step.emotion.moodDelta !== 0) {
    mood = Math.max(0, Math.min(100, mood + step.emotion.moodDelta));
    updateMoodUI();
  }

  // bubble
  const bubbleText = document.getElementById('bubble-text');
  bubbleText.innerHTML = '<div class="typing"><span></span><span></span><span></span></div>';
  const emo = document.getElementById('bubble-emotion');
  emo.style.display = 'none';
  document.getElementById('feedback-card').classList.remove('show');
  document.getElementById('btn-next').classList.remove('show');

  setTimeout(() => {
    bubbleText.textContent = step.clientText;
    emo.style.display = 'flex';
    document.getElementById('emotion-icon').textContent = step.emotion.icon;
    document.getElementById('emotion-label').textContent = step.emotion.label;
    renderChoices(step);
  }, 800);
}

function renderChoices(step) {
  const container = document.getElementById('choices');
  container.innerHTML = '';
  step.choices.forEach((choice, i) => {
    const btn = document.createElement('button');
    btn.className = 'choice-btn';
    btn.textContent = choice.text;
    btn.onclick = () => selectChoice(i, step);
    btn.style.animationDelay = (i * 0.06) + 's';
    btn.style.animation = 'fadeUp .4s ease both';
    container.appendChild(btn);
  });
}

function selectChoice(idx, step) {
  if (answered) return;
  answered = true;

  const choice = step.choices[idx];
  const buttons = document.querySelectorAll('.choice-btn');

  // update mood
  mood = Math.max(0, Math.min(100, mood + choice.moodDelta));
  if (choice.correct) correctCount++; else wrongCount++;
  updateMoodUI();

  // style buttons
  buttons.forEach((btn, i) => {
    btn.disabled = true;
    const c = step.choices[i];
    if (i === idx) {
      btn.className = 'choice-btn ' + (choice.correct ? 'selected-good pulse-good' : 'selected-bad shake');
    } else if (c.correct && !choice.correct) {
      btn.className = 'choice-btn revealed-good';
    }
    // add badge
    if (i === idx || (c.correct && !choice.correct)) {
      const badge = document.createElement('div');
      badge.className = 'choice-badge ' + (c.correct ? 'badge-good' : 'badge-bad');
      badge.textContent = c.badge;
      btn.appendChild(badge);
    }
  });

  // feedback
  const fb = document.getElementById('feedback-card');
  fb.className = 'feedback-card show ' + (choice.correct ? 'good' : 'bad');
  document.getElementById('feedback-title').textContent = choice.correct ? '✓ Верно' : '✗ Ошибка';
  document.getElementById('feedback-text').textContent = choice.feedback;

  // next button
  document.getElementById('btn-next').classList.add('show');

  // scroll to feedback
  setTimeout(() => fb.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
}

function nextStep() {
  currentStep++;
  if (currentStep >= currentScenario.steps.length) {
    showResult();
    return;
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
  setTimeout(renderStep, 300);
}

// ══════════════════════════════════════════
//  RESULT
// ══════════════════════════════════════════
function showResult() {
  const total = correctCount + wrongCount;
  const pct = Math.round((correctCount / total) * 100);
  const finalMood = Math.max(0, Math.min(100, mood));

  let emoji, title, desc;
  if (finalMood >= 80 && pct >= 75) {
    emoji = '🌟'; title = 'Великолепно!';
    desc = 'Клиент в восторге от обслуживания. Вы точно следовали стандартам ПВЗ и умело управляли эмоциями клиента.';
  } else if (finalMood >= 60 && pct >= 50) {
    emoji = '👍'; title = 'Хорошая работа';
    desc = 'Клиент остался доволен, но есть точки роста. Обратите внимание на шаги, где вы допустили ошибки.';
  } else if (finalMood >= 40) {
    emoji = '🤔'; title = 'Есть над чем работать';
    desc = 'Несколько ответов негативно повлияли на клиента. Перечитайте стандарты сервиса и попробуйте снова.';
  } else {
    emoji = '😕'; title = 'Нужна практика';
    desc = 'Клиент остался недоволен. Вернитесь к изучению стандартов обслуживания ПВЗ и попробуйте снова.';
  }

  document.getElementById('result-emoji').textContent = emoji;
  document.getElementById('result-title').textContent = title;
  document.getElementById('result-desc').textContent = desc;

  const scoreEl = document.getElementById('final-score');
  scoreEl.textContent = finalMood + ' / 100';
  scoreEl.className = 'score-value ' + (finalMood >= 60 ? 'good' : 'bad');

  document.getElementById('correct-count').textContent = correctCount + ' из ' + total;
  document.getElementById('correct-count').className = 'score-value ' + (pct >= 60 ? 'good' : 'bad');
  document.getElementById('wrong-count').textContent = wrongCount;
  document.getElementById('wrong-count').className = 'score-value ' + (wrongCount === 0 ? 'good' : 'bad');

  showScreen('result');
  setTimeout(() => {
    const bar = document.getElementById('final-bar');
    const moodData = getMoodData(finalMood);
    bar.style.width = finalMood + '%';
    bar.style.backgroundColor = moodData.color;
  }, 300);
}

function retryScenario() {
  startScenario(currentScenario.id);
}

// init
updateMoodUI();
</script>
<script>
function findAPI(win) {
    while (win.API == null && win.parent != null && win.parent != win) {
        win = win.parent;
    }
    return win.API;
}

var api = findAPI(window);

if (api) {
    api.LMSInitialize("");

    window.addEventListener("beforeunload", function () {
        api.LMSSetValue("cmi.core.lesson_status", "completed");
        api.LMSCommit("");
        api.LMSFinish("");
    });
}
</script>
