<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lamoda — Диалоговый тренажёр ПВЗ</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F7F5F2;
    --surface: #FFFFFF;
    --surface2: #F0EDE8;
    --border: #E2DDD7;
    --text-primary: #1A1A1A;
    --text-secondary: #6B6560;
    --text-muted: #A09890;
    --accent: #1A1A1A;
    --accent-soft: #2D2D2D;
    --good: #3D7A5C;
    --good-bg: #EBF4EF;
    --bad: #B5412B;
    --bad-bg: #FAECE9;
    --neutral: #6B6560;
    --mood-fill: #3D7A5C;
    --shadow: 0 4px 24px rgba(0,0,0,0.07);
    --shadow-hover: 0 8px 32px rgba(0,0,0,0.12);
    --radius: 16px;
    --radius-sm: 10px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Jost', sans-serif;
    background: var(--bg);
    color: var(--text-primary);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0;
    overflow-x: hidden;
  }

  /* ── SCREENS ── */
  .screen { display: none; width: 100%; min-height: 100vh; flex-direction: column; align-items: center; }
  .screen.active { display: flex; }

  /* ── INTRO ── */
  #intro {
    background: var(--accent);
    color: #fff;
    justify-content: center;
    padding: 40px 24px;
    position: relative;
    overflow: hidden;
  }
  #intro::before {
    content: '';
    position: absolute;
    top: -120px; right: -100px;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: rgba(255,255,255,0.04);
  }
  #intro::after {
    content: '';
    position: absolute;
    bottom: -80px; left: -60px;
    width: 300px; height: 300px;
    border-radius: 50%;
    background: rgba(255,255,255,0.03);
  }
  .intro-inner {
    max-width: 480px;
    width: 100%;
    text-align: center;
    position: relative;
    z-index: 1;
    animation: fadeUp .7s ease both;
  }
  .brand-logo {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 6px;
    text-transform: uppercase;
    opacity: .6;
    margin-bottom: 48px;
  }
  .intro-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: clamp(32px, 8vw, 52px);
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .intro-subtitle {
    font-size: 14px;
    font-weight: 300;
    opacity: .65;
    line-height: 1.6;
    margin-bottom: 48px;
    letter-spacing: .3px;
  }
  .btn-start {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    color: var(--accent);
    border: none;
    padding: 16px 36px;
    border-radius: 50px;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .5px;
    cursor: pointer;
    transition: transform .2s, box-shadow .2s;
  }
  .btn-start:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(255,255,255,0.15); }
  .btn-start svg { transition: transform .2s; }
  .btn-start:hover svg { transform: translateX(4px); }
  .intro-note {
    margin-top: 32px;
    font-size: 12px;
    opacity: .35;
    letter-spacing: .3px;
  }

  /* ── SELECTOR ── */
  #selector {
    background: var(--bg);
    padding: 40px 20px 60px;
    justify-content: flex-start;
  }
  .selector-header {
    width: 100%;
    max-width: 560px;
    margin-bottom: 32px;
    animation: fadeUp .5s ease both;
  }
  .back-btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; color: var(--text-muted); letter-spacing: .5px;
    background: none; border: none; cursor: pointer;
    font-family: 'Jost', sans-serif;
    padding: 0; margin-bottom: 24px;
    transition: color .2s;
  }
  .back-btn:hover { color: var(--text-primary); }
  .selector-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 30px; font-weight: 300;
    line-height: 1.2;
    margin-bottom: 6px;
  }
  .selector-sub { font-size: 13px; color: var(--text-muted); font-weight: 300; }
  .scenario-grid {
    width: 100%; max-width: 560px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .scenario-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 22px;
    cursor: pointer;
    display: flex; align-items: center; gap: 16px;
    transition: border-color .2s, box-shadow .2s, transform .15s;
    animation: fadeUp .5s ease both;
  }
  .scenario-card:hover { border-color: var(--accent); box-shadow: var(--shadow); transform: translateY(-2px); }
  .sc-icon {
    width: 44px; height: 44px; border-radius: 12px;
    background: var(--surface2);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; font-size: 20px;
  }
  .sc-info { flex: 1; }
  .sc-title { font-size: 14px; font-weight: 500; margin-bottom: 3px; }
  .sc-desc { font-size: 12px; color: var(--text-muted); line-height: 1.5; }
  .sc-diff {
    font-size: 11px; font-weight: 500; letter-spacing: .5px;
    padding: 4px 10px; border-radius: 20px;
    flex-shrink: 0;
  }
  .diff-easy { background: #EBF4EF; color: var(--good); }
  .diff-med { background: #FEF3E8; color: #B57A2B; }
  .diff-hard { background: var(--bad-bg); color: var(--bad); }

  /* ── GAME ── */
  #game {
    background: var(--bg);
    padding: 0;
    justify-content: flex-start;
    align-items: stretch;
  }
  .game-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    position: sticky; top: 0; z-index: 10;
  }
  .game-title-sm {
    flex: 1;
    font-size: 13px; font-weight: 500;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .progress-wrap { display: flex; align-items: center; gap: 10px; }
  .progress-label { font-size: 11px; color: var(--text-muted); white-space: nowrap; }

  /* Mood bar */
  .mood-section {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 12px 20px;
    display: flex; align-items: center; gap: 12px;
  }
  .mood-icon { font-size: 22px; transition: all .4s; flex-shrink: 0; }
  .mood-bar-wrap { flex: 1; }
  .mood-bar-label { font-size: 11px; color: var(--text-muted); margin-bottom: 5px; display: flex; justify-content: space-between; }
  .mood-bar-track { height: 6px; background: var(--surface2); border-radius: 10px; overflow: hidden; }
  .mood-bar-fill { height: 100%; border-radius: 10px; transition: width .6s cubic-bezier(.4,0,.2,1), background-color .6s; }
  .mood-score { font-size: 14px; font-weight: 500; min-width: 28px; text-align: right; }

  /* Scene */
  .scene-wrap { padding: 20px; max-width: 640px; margin: 0 auto; width: 100%; }
  
  /* Scenario step indicator */
  .step-indicator {
    display: flex; gap: 6px; margin-bottom: 20px;
  }
  .step-dot {
    height: 3px; flex: 1; border-radius: 10px;
    background: var(--border);
    transition: background .4s;
  }
  .step-dot.done { background: var(--accent); }
  .step-dot.active { background: var(--accent); opacity: .5; }

  /* Character bubble */
  .char-section { display: flex; align-items: flex-end; gap: 14px; margin-bottom: 22px; }
  .char-avatar {
    width: 52px; height: 68px; border-radius: 14px;
    flex-shrink: 0; position: relative; overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .char-avatar svg { width: 100%; height: 100%; }
  .bubble {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px 16px 16px 4px;
    padding: 14px 16px;
    flex: 1;
    box-shadow: var(--shadow);
    position: relative;
  }
  .bubble-name { font-size: 11px; font-weight: 500; letter-spacing: .5px; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; }
  .bubble-text { font-size: 14px; line-height: 1.6; color: var(--text-primary); }
  .bubble-emotion {
    display: inline-flex; align-items: center; gap: 5px;
    margin-top: 10px; font-size: 11px; color: var(--text-muted);
    background: var(--surface2); padding: 3px 10px; border-radius: 20px;
  }

  /* Choices */
  .choices-label { font-size: 12px; font-weight: 500; letter-spacing: .5px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 12px; }
  .choices { display: flex; flex-direction: column; gap: 10px; }
  .choice-btn {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    text-align: left;
    cursor: pointer;
    font-family: 'Jost', sans-serif;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-primary);
    transition: border-color .2s, background .2s, transform .15s, box-shadow .2s;
    position: relative;
    overflow: hidden;
  }
  .choice-btn:hover:not(:disabled) {
    border-color: var(--accent);
    background: var(--surface2);
    transform: translateY(-1px);
    box-shadow: var(--shadow);
  }
  .choice-btn:disabled { cursor: default; }
  .choice-btn.selected-good {
    border-color: var(--good);
    background: var(--good-bg);
    color: var(--good);
  }
  .choice-btn.selected-bad {
    border-color: var(--bad);
    background: var(--bad-bg);
    color: var(--bad);
  }
  .choice-btn.revealed-good {
    border-color: var(--good);
    background: var(--good-bg);
    color: var(--good);
    opacity: .6;
  }
  .choice-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 11px; font-weight: 500;
    margin-top: 6px; padding: 2px 8px; border-radius: 20px;
  }
  .badge-good { background: rgba(61,122,92,.12); color: var(--good); }
  .badge-bad { background: rgba(181,65,43,.12); color: var(--bad); }

  /* Feedback */
  .feedback-card {
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    margin-top: 16px;
    font-size: 13px;
    line-height: 1.6;
    animation: fadeUp .3s ease both;
    display: none;
  }
  .feedback-card.show { display: block; }
  .feedback-card.good { background: var(--good-bg); border: 1px solid rgba(61,122,92,.2); color: #2C5C42; }
  .feedback-card.bad { background: var(--bad-bg); border: 1px solid rgba(181,65,43,.2); color: #8B3120; }
  .feedback-title { font-weight: 500; margin-bottom: 4px; font-size: 12px; text-transform: uppercase; letter-spacing: .5px; }

  /* Next button */
  .btn-next {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; margin-top: 20px;
    background: var(--accent); color: #fff;
    border: none; border-radius: var(--radius-sm);
    padding: 15px;
    font-family: 'Jost', sans-serif; font-size: 14px; font-weight: 500;
    cursor: pointer; letter-spacing: .3px;
    transition: background .2s, transform .15s;
    display: none;
  }
  .btn-next.show { display: flex; }
  .btn-next:hover { background: #333; transform: translateY(-1px); }

  /* ── RESULT ── */
  #result {
    background: var(--bg);
    padding: 40px 20px 60px;
    justify-content: center;
    align-items: center;
  }
  .result-inner {
    max-width: 480px; width: 100%; text-align: center;
    animation: fadeUp .6s ease both;
  }
  .result-emoji { font-size: 64px; margin-bottom: 24px; display: block; }
  .result-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px; font-weight: 300;
    margin-bottom: 12px; line-height: 1.2;
  }
  .result-desc { font-size: 14px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 32px; }
  .result-score-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 24px;
    margin-bottom: 28px;
    display: flex; flex-direction: column; gap: 16px;
  }
  .score-row { display: flex; justify-content: space-between; align-items: center; }
  .score-label { font-size: 13px; color: var(--text-muted); }
  .score-value { font-size: 14px; font-weight: 500; }
  .score-value.good { color: var(--good); }
  .score-value.bad { color: var(--bad); }
  .final-bar-wrap { background: var(--surface2); border-radius: 10px; height: 8px; overflow: hidden; }
  .final-bar-fill { height: 100%; border-radius: 10px; transition: width 1s cubic-bezier(.4,0,.2,1); }
  .result-btns { display: flex; flex-direction: column; gap: 10px; }
  .btn-retry {
    background: var(--accent); color: #fff; border: none;
    padding: 15px; border-radius: var(--radius-sm);
    font-family: 'Jost', sans-serif; font-size: 14px; font-weight: 500;
    cursor: pointer; transition: background .2s;
    letter-spacing: .3px;
  }
  .btn-retry:hover { background: #333; }
  .btn-menu {
    background: transparent; color: var(--text-secondary);
    border: 1.5px solid var(--border); padding: 14px;
    border-radius: var(--radius-sm);
    font-family: 'Jost', sans-serif; font-size: 14px;
    cursor: pointer; transition: border-color .2s, color .2s;
    letter-spacing: .3px;
  }
  .btn-menu:hover { border-color: var(--accent); color: var(--text-primary); }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes shake {
    0%,100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }
  .shake { animation: shake .3s ease; }
  @keyframes pulse-good {
    0% { box-shadow: 0 0 0 0 rgba(61,122,92,.3); }
    70% { box-shadow: 0 0 0 10px rgba(61,122,92,0); }
    100% { box-shadow: 0 0 0 0 rgba(61,122,92,0); }
  }
  .pulse-good { animation: pulse-good .6s ease; }

  /* Typing indicator */
  .typing { display: flex; gap: 4px; align-items: center; padding: 4px 0; }
  .typing span {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--text-muted); animation: bounce .8s infinite;
  }
  .typing span:nth-child(2) { animation-delay: .15s; }
  .typing span:nth-child(3) { animation-delay: .3s; }
  @keyframes bounce {
    0%,80%,100% { transform: translateY(0); opacity: .4; }
    40% { transform: translateY(-5px); opacity: 1; }
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
</style>
</head>
<body>

<!-- ══════════ INTRO ══════════ -->
<div id="intro" class="screen active">
  <div class="intro-inner">
    <div class="brand-logo">Lamoda · Обучение</div>
    <h1 class="intro-title">Диалоговый<br>тренажёр ПВЗ</h1>
    <p class="intro-subtitle">Отработай реальные ситуации в пункте выдачи заказов.<br>Твои ответы влияют на настроение клиента.</p>
    <button class="btn-start" onclick="showSelector()">
      Начать обучение
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <p class="intro-note">3 сценария · ~10 минут</p>
  </div>
</div>

<!-- ══════════ SELECTOR ══════════ -->
<div id="selector" class="screen">
  <div class="selector-header">
    <button class="back-btn" onclick="showIntro()">
      ← Назад
    </button>
    <h2 class="selector-title">Выбери сценарий</h2>
    <p class="selector-sub">Каждый случай — реальная ситуация из практики ПВЗ</p>
  </div>
  <div class="scenario-grid">
    <div class="scenario-card" onclick="startScenario(0)" style="animation-delay:.05s">
      <div class="sc-icon">📦</div>
      <div class="sc-info">
        <div class="sc-title">Бракованный товар</div>
        <div class="sc-desc">Клиент обнаружил дефект при получении заказа</div>
      </div>
      <span class="sc-diff diff-easy">Базовый</span>
    </div>
    <div class="scenario-card" onclick="startScenario(1)" style="animation-delay:.1s">
      <div class="sc-icon">💳</div>
      <div class="sc-info">
        <div class="sc-title">Платная доставка</div>
        <div class="sc-desc">Клиент недоволен списанием за доставку</div>
      </div>
      <span class="sc-diff diff-med">Средний</span>
    </div>
    <div class="scenario-card" onclick="startScenario(2)" style="animation-delay:.15s">
      <div class="sc-icon">🔄</div>
      <div class="sc-info">
        <div class="sc-title">Очередь в час-пик</div>
        <div class="sc-desc">Большая очередь, клиент нервничает и требует внимания</div>
      </div>
      <span class="sc-diff diff-hard">Сложный</span>
    </div>
  </div>
</div>

<!-- ══════════ GAME ══════════ -->
<div id="game" class="screen">
  <div class="game-header">
    <button class="back-btn" onclick="showSelector()" style="margin-bottom:0">← Меню</button>
    <div class="game-title-sm" id="game-title-sm">Сценарий</div>
    <div class="progress-wrap">
      <span class="progress-label" id="progress-label">1 / 4</span>
    </div>
  </div>

  <div class="mood-section">
    <div class="mood-icon" id="mood-icon">😐</div>
    <div class="mood-bar-wrap">
      <div class="mood-bar-label">
        <span>Настроение клиента</span>
        <span id="mood-text">Нейтральное</span>
      </div>
      <div class="mood-bar-track">
        <div class="mood-bar-fill" id="mood-bar" style="width:60%;background:var(--neutral)"></div>
      </div>
    </div>
    <div class="mood-score" id="mood-score">60</div>
  </div>

  <div class="scene-wrap">
    <div class="step-indicator" id="step-indicator"></div>

    <div class="char-section">
      <div class="char-avatar" id="char-avatar">
        <!-- SVG avatar injected by JS -->
      </div>
      <div class="bubble">
        <div class="bubble-name" id="bubble-name">Клиент</div>
        <div class="bubble-text" id="bubble-text">
          <div class="typing"><span></span><span></span><span></span></div>
        </div>
        <div class="bubble-emotion" id="bubble-emotion" style="display:none">
          <span id="emotion-icon">😐</span>
          <span id="emotion-label">Нейтрально</span>
        </div>
      </div>
    </div>

    <div class="choices-label">Ваш ответ</div>
    <div class="choices" id="choices"></div>

    <div class="feedback-card" id="feedback-card">
      <div class="feedback-title" id="feedback-title"></div>
      <div id="feedback-text"></div>
    </div>

    <button class="btn-next" id="btn-next" onclick="nextStep()">
      Продолжить
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</div>

<!-- ══════════ RESULT ══════════ -->
<div id="result" class="screen">
  <div class="result-inner">
    <span class="result-emoji" id="result-emoji">🎉</span>
    <h2 class="result-title" id="result-title">Отличная работа!</h2>
    <p class="result-desc" id="result-desc">Клиент остался доволен обслуживанием.</p>

    <div class="result-score-card">
      <div class="score-row">
        <span class="score-label">Итоговый балл клиента</span>
        <span class="score-value" id="final-score">—</span>
      </div>
      <div class="final-bar-wrap">
        <div class="final-bar-fill" id="final-bar" style="width:0%"></div>
      </div>
      <div class="score-row">
        <span class="score-label">Правильных ответов</span>
        <span class="score-value" id="correct-count">—</span>
      </div>
      <div class="score-row">
        <span class="score-label">Ошибок</span>
        <span class="score-value" id="wrong-count">—</span>
      </div>
    </div>

    <div class="result-btns">
      <button class="btn-retry" onclick="retryScenario()">Попробовать снова</button>
      <button class="btn-menu" onclick="showSelector()">Другой сценарий</button>
    </div>
  </div>
</div>

<script>
// ══════════════════════════════════════════
//  DATA — SCENARIOS
// ══════════════════════════════════════════
const scenarios = [
  // ─────────── 0: БРАКОВАННЫЙ ТОВАР ───────────
  {
    id: 0,
    title: 'Бракованный товар',
    clientName: 'Анна',
    clientType: 'woman',
